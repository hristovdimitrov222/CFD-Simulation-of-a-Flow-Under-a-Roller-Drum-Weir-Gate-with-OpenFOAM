FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue alpha.water 1//only water in the domain
);

regions
(
    boxToCell
    {
        box (0 0.408 0) (0.61 0.7 0.5);
        fieldValues
        (
            volScalarFieldValue alpha.water 0//we set our block of air into the domain
        );
    }
	
	    boxToCell
    {
        box (0.61 0.127 0) (2.5 0.7 0.5);
        fieldValues
        (
            volScalarFieldValue alpha.water 0//we set our block of air into the domain
        );
    }
);


